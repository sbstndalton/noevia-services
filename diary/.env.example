# Copy to .env next to docker-compose.yml and fill in.
# Do not commit the filled-in .env.

# Nextcloud WebDAV credentials (Nextcloud AIO Apache, per DaServer.md port table)
WEBDAV_BASE_URL=http://10.69.0.130:11000/remote.php/dav/files/YOUR_NEXTCLOUD_USER/
WEBDAV_USERNAME=YOUR_NEXTCLOUD_USER
WEBDAV_PASSWORD=your-app-password-here

# Where the diary corpus lives inside Nextcloud (must match the Mac's sync location)
CORPUS_REMOTE_ROOT=Diary

# Lemonade (install models via its /v1/pull API or web UI first)
LLM_BASE_URL=http://10.69.0.130:13305/v1
LLM_CHAT_MODEL=Gemma-4-E4B-it-GGUF
LLM_EMBED_MODEL=nomic-embed-text-v1-GGUF

# Optional: separate aux model server (Phase 1a-2 A380 SYCL offload); defaults to Lemonade
# LLM_AUX_BASE_URL=http://10.69.0.130:13306/v1
# LLM_AUX_MODEL=gemma-4-E2B-it-GGUF-Q8_0

# SQLite (vector index + write-ahead journal) — persistent volume
DB_PATH=data/index.db

# UI
DIARY_PORT=8010

# Access token for the UI and the /v1 API (Solair AI uses it as its API key).
# Leave empty for open LAN-only mode; REQUIRED before exposing via Cloudflare Tunnel.
# Generate: openssl rand -base64 24
DIARY_AUTH_TOKEN=
