# Key names only. make_env.sh writes .env.gate (gitignored, mode 600) with fresh random test
# secrets. Inference URLs come from GATE_* variables in the caller's environment, or point at an
# unresolvable name with --no-inference. Never put production secrets here.
DIARY_AUTH_TOKEN=
DIARY_TENANT_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_AUX_BASE_URL=
LLM_AUX_MODEL=
LLM_EMBED_BASE_URL=
LLM_EMBED_MODEL=
LLM_EMBED_PROFILE=
# Host side only (harness load gate); the diary ignores them.
GATE_EMBED_LOAD_URL=
GATE_KEV_LOAD_URL=
